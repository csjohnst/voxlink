[server]
host = "mumble.example.com"
port = 64738
username = "chris"
# password stored in system keyring, not plaintext
# Client certificate (PEM). Required when the server has registered your username
# against a certificate (reject reason: "Wrong certificate or password for existing user").
# Export from Mumble desktop: Configure > Certificate Wizard > Export, then
#   openssl pkcs12 -in cert.p12 -legacy -passin pass: -clcerts -nokeys -out client.pem
#   openssl pkcs12 -in cert.p12 -legacy -passin pass: -nocerts -nodes -out client.key
certfile = ""               # e.g. "~/.config/voxlink/certs/client.pem"
keyfile = ""                # e.g. "~/.config/voxlink/certs/client.key"

[audio]
input_device = ""           # PipeWire device name (leave empty for default)
output_device = ""          # PipeWire device name (leave empty for default)
input_volume = 80           # 0-100
output_volume = 100         # 0-100
quality = "high"            # low / medium / high (maps to opus bitrate)
noise_suppression = true

[ptt]
mode = "ptt"                # "ptt" or "vad" or "continuous"
shortcut_method = "portal"  # "portal" or "evdev"
evdev_key = "KEY_F13"       # Only used if method = evdev
vad_threshold = 0.02        # Only used if mode = vad

[ui]
start_minimized = false
show_tray_icon = true
compact_mode = false
